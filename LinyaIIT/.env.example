# ==============================================================================
# LinyaIIT Environment Variables (100% Free Supabase Tier — No Credit Card)
# ==============================================================================
# Copy this file to `.env` for local development, or add these exact two keys
# in Vercel / Netlify / Cloudflare Pages Environment Variables when deploying.
#
# Get these from: Supabase Dashboard -> Project Settings -> API
# NEVER put your `service_role` key here. Only the public `anon` key is safe
# for frontend browsers because Row Level Security (RLS) protects your data.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-PUBLIC-KEY
